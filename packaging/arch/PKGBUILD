# Maintainer: Kelvao <https://github.com/Kelvao/Scarlett-Control>
pkgname=scarlett-control
pkgver=1.0.0
pkgrel=1
pkgdesc="Lightweight hardware control and system tray indicator for Focusrite Scarlett 2i2"
arch=('x86_64' 'aarch64')
url="https://github.com/Kelvao/Scarlett-Control"
license=('MIT')
depends=('glibc')
optdepends=(
    'gtk3: for system tray icon support'
    'libayatana-appindicator: for StatusNotifierItem support in GNOME/KDE'
)
source=("$pkgname-$pkgver.tar.gz")
sha256sums=('SKIP')

build() {
    cd "$pkgname-$pkgver"
    make
}

package() {
    cd "$pkgname-$pkgver"
    make DESTDIR="$pkgdir" PREFIX="/usr" install
}
